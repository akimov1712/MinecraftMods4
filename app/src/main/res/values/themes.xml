<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Obsidian window with edge-to-edge system bars: the OS splash hands over to the Compose
        ignition screen without a light flash in between.
    -->
    <style name="Theme.ModStore" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
