<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="walkthrough_title">설치 방법</string>
    <string name="walkthrough_step_label">단계 %1$d</string>
    <string name="walkthrough_s1_title">콘텐츠 선택</string>
    <string name="walkthrough_s1_text">카탈로그에서 아무 콘텐츠나 열고 ‘파일 받기’를 누르세요.</string>
    <string name="walkthrough_s2_title">파일 다운로드</string>
    <string name="walkthrough_s2_text">‘다운로드’를 누르고 파일 저장이 끝날 때까지 기다리세요.</string>
    <string name="walkthrough_s3_title">‘설치’ 누르기</string>
    <string name="walkthrough_s3_text">저장된 후 ‘설치’를 누르면 어떤 앱으로 열지 묻습니다.</string>
    <string name="walkthrough_s4_title">Minecraft 선택</string>
    <string name="walkthrough_s4_text">목록에서 Minecraft를 선택하세요. 게임이 열리고 콘텐츠를 가져옵니다.</string>
    <string name="walkthrough_s5_title">가져오기 대기</string>
    <string name="walkthrough_s5_text">Minecraft가 가져오기 진행률을 표시합니다. 끝날 때까지 기다리세요.</string>
    <string name="walkthrough_s6_title">월드에서 활성화</string>
    <string name="walkthrough_s6_text">월드 설정에서 리소스 팩 또는 비헤이비어 팩으로 추가하세요.</string>
    <string name="walkthrough_s7_title">즐기세요!</string>
    <string name="walkthrough_s7_text">월드를 시작하고 새 콘텐츠를 즐기세요. 먼저 중요한 월드를 백업하세요.</string>
</resources>
