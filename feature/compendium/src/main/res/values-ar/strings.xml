<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="compendium_title">المساعد</string>
    <string name="faq_what_q">ماذا يفعل هذا التطبيق؟</string>
    <string name="faq_what_a">يتيح لك تصفّح وتثبيت محتوى مجاني — إضافات وخرائط وقوام وسكنات — لـ Minecraft.</string>
    <string name="faq_internet_q">هل أحتاج إلى اتصال بالإنترنت؟</string>
    <string name="faq_internet_a">نعم، للتصفّح والتنزيل. بعد حفظ الملف يمكنك تثبيته دون اتصال.</string>
    <string name="faq_how_q">كيف أثبّت محتوى؟</string>
    <string name="faq_how_a">افتح محتوى، اضغط «الحصول على الملفات»، نزّل الملف ثم اضغط «تثبيت» — يفتح Minecraft ويستوردها تلقائيًا.</string>
    <string name="faq_fail_q">لم ينجح التثبيت. ماذا الآن؟</string>
    <string name="faq_fail_a">تأكد من أن Minecraft مثبّت ومحدّث، ثم أعد محاولة تثبيت الملف.</string>
    <string name="faq_stuck_q">التنزيل متوقف.</string>
    <string name="faq_stuck_a">بعض الملفات على خوادم بطيئة في مناطق معينة. غالبًا ما يساعد تشغيل VPN.</string>
    <string name="faq_hidden_q">ثبّته لكنني لا أجده في اللعبة.</string>
    <string name="faq_hidden_a">فعّل الحزمة في إعدادات العالم وشغّل الخيارات التجريبية المطلوبة.</string>
    <string name="faq_lag_q">اللعبة تتقطّع بعد التثبيت.</string>
    <string name="faq_lag_a">الإضافات الثقيلة تحتاج موارد أكثر. قلّل مسافة العرض أو أزل حزمًا أخرى.</string>
    <string name="faq_ads_q">لماذا توجد إعلانات؟</string>
    <string name="faq_ads_a">الإعلانات تبقي التطبيق وكل المحتوى مجانيًا بالكامل.</string>
    <string name="faq_free_q">هل كل شيء مجاني؟</string>
    <string name="faq_free_a">نعم — كل محتوى في الكتالوج مجاني للتنزيل والتثبيت.</string>
    <string name="faq_fresh_q">كم مرة يُضاف محتوى جديد؟</string>
    <string name="faq_fresh_a">يُحدَّث الكتالوج بانتظام بمحتوى جديد.</string>
    <string name="faq_safe_q">هل الملفات آمنة على عوالمي؟</string>
    <string name="faq_safe_a">المحتوى مُعبّأ بصيغ Minecraft نفسها. خذ نسخة احتياطية من عوالمك المهمة قبل إضافة إضافات كبيرة.</string>
    <string name="compendium_subtitle">إجابات عن الأسئلة الشائعة</string>
    <string name="compendium_greeting">مرحبًا! اختر سؤالًا بالأسفل وسأجيب هنا.</string>
    <string name="compendium_prompt">اضغط على سؤال</string>
    <string name="compendium_restart">البدء من جديد</string>
    <string name="compendium_done">هذا كل ما أعرفه. اضغط بالأعلى للبدء من جديد.</string>
