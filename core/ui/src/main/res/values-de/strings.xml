    <!-- How to install -->
    <string name="walkthrough_title">Installation</string>
    <string name="walkthrough_s1_title">Inhalt auswählen</string>
    <string name="walkthrough_s1_text">Öffne einen beliebigen Inhalt im Katalog und tippe auf „Dateien holen“.</string>
    <string name="walkthrough_s2_title">Datei herunterladen</string>
    <string name="walkthrough_s2_text">Tippe auf „Herunterladen“ und warte, bis die Datei gespeichert ist.</string>
    <string name="walkthrough_s3_title">Auf „Installieren“ tippen</string>
    <string name="walkthrough_s3_text">Nach dem Speichern auf „Installieren“ tippen — das System fragt, welche App die Datei öffnen soll.</string>
    <string name="walkthrough_s4_title">Minecraft wählen</string>
    <string name="walkthrough_s4_text">Wähle Minecraft aus der Liste. Das Spiel öffnet sich und importiert den Inhalt.</string>
    <string name="walkthrough_s5_title">Auf den Import warten</string>
    <string name="walkthrough_s5_text">Minecraft zeigt einen Importfortschritt. Lass ihn abschließen.</string>
    <string name="walkthrough_s6_title">In deiner Welt aktivieren</string>
    <string name="walkthrough_s6_text">Füge das Paket in den Welteinstellungen unter Ressourcen- oder Verhaltenspaketen hinzu.</string>
    <string name="walkthrough_s7_title">Viel Spaß!</string>
    <string name="walkthrough_s7_text">Starte die Welt und genieße deinen neuen Inhalt. Sichere zuerst wichtige Welten.</string>

