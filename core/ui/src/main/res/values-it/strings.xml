    <!-- How to install -->
    <string name="walkthrough_title">Come installare</string>
    <string name="walkthrough_s1_title">Scegli un contenuto</string>
    <string name="walkthrough_s1_text">Apri un contenuto qualsiasi dal catalogo e tocca «Ottieni i file».</string>
    <string name="walkthrough_s2_title">Scarica il file</string>
    <string name="walkthrough_s2_text">Tocca «Scarica» e attendi che il file finisca di salvarsi.</string>
    <string name="walkthrough_s3_title">Tocca «Installa»</string>
    <string name="walkthrough_s3_text">Una volta salvato, tocca «Installa»: il sistema chiede con quale app aprire il file.</string>
    <string name="walkthrough_s4_title">Scegli Minecraft</string>
    <string name="walkthrough_s4_text">Seleziona Minecraft dall\'elenco. Il gioco si apre e importa il contenuto.</string>
    <string name="walkthrough_s5_title">Attendi l\'importazione</string>
    <string name="walkthrough_s5_text">Minecraft mostra una barra di avanzamento. Lasciala completare.</string>
    <string name="walkthrough_s6_title">Attivalo nel tuo mondo</string>
    <string name="walkthrough_s6_text">Nelle impostazioni del mondo, aggiungi il pacchetto tra i pacchetti risorse o comportamento.</string>
    <string name="walkthrough_s7_title">Buon divertimento!</string>
    <string name="walkthrough_s7_text">Avvia il mondo e goditi il nuovo contenuto. Prima fai un backup dei mondi importanti.</string>

