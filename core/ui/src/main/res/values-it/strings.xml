    <!-- How to install -->
    <string name="walkthrough_title">Come portarlo nel gioco</string>
    <string name="walkthrough_s1_title">Scegli qualcosa</string>
    <string name="walkthrough_s1_text">Apri una scheda dallo scaffale e tocca «Prendi i file».</string>
    <string name="walkthrough_s2_title">Prendi il file</string>
    <string name="walkthrough_s2_text">Tocca Prendi e aspetta che il file sia sul telefono.</string>
    <string name="walkthrough_s3_title">Passalo</string>
    <string name="walkthrough_s3_text">Quando è salvato, tocca Passa a Minecraft: il sistema chiede quale app prende il file.</string>
    <string name="walkthrough_s4_title">Indica Minecraft</string>
    <string name="walkthrough_s4_text">Scegli Minecraft dall\'elenco. Il gioco si apre da solo e inizia a tirare dentro il contenuto.</string>
    <string name="walkthrough_s5_title">Lascialo finire</string>
    <string name="walkthrough_s5_text">Minecraft mostra una barra durante l\'importazione. Non uscire dal gioco finché non finisce.</string>
    <string name="walkthrough_s6_title">Attivalo nel tuo mondo</string>
    <string name="walkthrough_s6_text">Nelle impostazioni del mondo, aggiungi il pacchetto fra risorse o comportamenti.</string>
    <string name="walkthrough_s7_title">Vai a giocare</string>
    <string name="walkthrough_s7_text">Avvia il mondo e guarda cos\'è cambiato. Copia prima i mondi a cui tieni.</string>

