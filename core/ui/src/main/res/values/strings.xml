    <!-- How to install -->
    <string name="walkthrough_title">Getting it into the game</string>
    <string name="walkthrough_s1_title">Choose something</string>
    <string name="walkthrough_s1_text">Open any card from the shelf and press “Take the files”.</string>
    <string name="walkthrough_s2_title">Take the file</string>
    <string name="walkthrough_s2_text">Press Take it and wait until the file is on your phone.</string>
    <string name="walkthrough_s3_title">Hand it over</string>
    <string name="walkthrough_s3_text">When it is saved, press Hand it to Minecraft — the system asks which app should take the file.</string>
    <string name="walkthrough_s4_title">Point at Minecraft</string>
    <string name="walkthrough_s4_text">Pick Minecraft from that list. The game opens by itself and starts pulling the content in.</string>
    <string name="walkthrough_s5_title">Let it finish</string>
    <string name="walkthrough_s5_text">Minecraft shows a bar while it imports. Do not leave the game until it reaches the end.</string>
    <string name="walkthrough_s6_title">Switch it on in the world</string>
    <string name="walkthrough_s6_text">In the world settings, add the pack under resource or behaviour packs.</string>
    <string name="walkthrough_s7_title">Go play</string>
    <string name="walkthrough_s7_text">Start the world and see what changed. Copy worlds you care about before adding anything.</string>

