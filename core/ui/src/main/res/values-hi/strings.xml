    <!-- FAQ -->
    <string name="compendium_title">सहायक</string>
    <string name="faq_what_q">यह ऐप क्या करता है?</string>
    <string name="faq_what_a">यह आपको Minecraft के लिए मुफ़्त कंटेंट — ऐडऑन, मानचित्र, टेक्सचर और स्किन — ब्राउज़ और इंस्टॉल करने देता है।</string>
    <string name="faq_internet_q">क्या मुझे इंटरनेट चाहिए?</string>
    <string name="faq_internet_a">हाँ, ब्राउज़ और डाउनलोड के लिए। फ़ाइल सहेजने के बाद आप उसे ऑफ़लाइन इंस्टॉल कर सकते हैं।</string>
    <string name="faq_how_q">कंटेंट कैसे इंस्टॉल करें?</string>
    <string name="faq_how_a">कोई मॉड खोलो, «फ़ाइलें लें» दबाओ, फिर «डाउनलोड»। सेव होने पर «Minecraft में खोलें» दबाओ — गेम खुलकर उसे खुद जोड़ लेगा।</string>
    <string name="faq_fail_q">इंस्टॉल नहीं हुआ। अब क्या करें?</string>
    <string name="faq_fail_a">देखो कि Minecraft इंस्टॉल और अपडेट है, फिर फ़ाइल दोबारा खोलो। अगर डाउनलोड पूरा नहीं हुआ तो VPN चालू करके फिर से लो।</string>
    <string name="faq_stuck_q">मेरा डाउनलोड अटक गया है।</string>
    <string name="faq_stuck_a">आमतौर पर तुम्हारा इंटरनेट प्रोवाइडर सर्वर को ब्लॉक करता है। VPN चालू करो और फिर से डाउनलोड करो — लगभग हमेशा काम करता है। कोई भी मुफ़्त VPN चलेगा, बाद में बंद कर सकते हो।</string>
    <string name="faq_hidden_q">इंस्टॉल किया पर गेम में नहीं दिखता।</string>
    <string name="faq_hidden_a">अपनी दुनिया की सेटिंग में जाओ और वहाँ पैक चालू करो। कुछ मॉड को एक्सपेरिमेंट भी ऑन चाहिए।</string>
    <string name="faq_lag_q">इंस्टॉल के बाद गेम धीमा चलता है।</string>
    <string name="faq_lag_a">बड़े मॉड फ़ोन पर भारी पड़ते हैं। रेंडर दूरी कम करो या दुनिया से दूसरे पैक हटाओ।</string>
    <string name="faq_ads_q">विज्ञापन क्यों हैं?</string>
    <string name="faq_ads_a">विज्ञापन ऐप और सारे कंटेंट को पूरी तरह मुफ़्त रखते हैं।</string>
    <string name="faq_free_q">क्या सब कुछ मुफ़्त है?</string>
    <string name="faq_free_a">हाँ — कैटलॉग का हर कंटेंट डाउनलोड और इंस्टॉल करने के लिए मुफ़्त है।</string>
    <string name="faq_fresh_q">नया कंटेंट कितनी बार जुड़ता है?</string>
    <string name="faq_fresh_a">कैटलॉग में नियमित रूप से नया कंटेंट जोड़ा जाता है।</string>
    <string name="faq_safe_q">क्या फ़ाइलें मेरे वर्ल्ड के लिए सुरक्षित हैं?</string>
    <string name="faq_safe_a">हाँ। ये Minecraft की ही फ़ाइलें हैं। फिर भी बड़े मॉड से पहले ज़रूरी दुनिया की कॉपी बना लो।</string>
