    <!-- FAQ -->
    <string name="compendium_title">गाइड</string>
    <string name="faq_what_q">यह ऐप किसलिए है?</string>
    <string name="faq_what_a">यह Minecraft के लिए मुफ़्त सामग्री की शेल्फ़ है: ऐड-ऑन, वर्ल्ड, रिसोर्स पैक और स्किन। चुनें, फ़ाइल लें — गेम उसे खोल देगा।</string>
    <string name="faq_internet_q">क्या इंटरनेट चाहिए?</string>
    <string name="faq_internet_a">देखने और फ़ाइल लेने के लिए हाँ। फ़ाइल फ़ोन में आ जाए तो बिना नेट के भी गेम में जाती है।</string>
    <string name="faq_how_q">मॉड गेम में कैसे डालें?</string>
    <string name="faq_how_a">मॉड खोलें, «फ़ाइलें लें» दबाएँ, फिर «लें»। फ़ाइल फ़ोन में आने पर «Minecraft को दें» दबाएँ — गेम खुलकर उसे ले लेगा।</string>
    <string name="faq_fail_q">इंस्टॉल नहीं हुआ। अब क्या?</string>
    <string name="faq_fail_a">पहले देखें कि Minecraft इंस्टॉल और अपडेटेड है, फिर फ़ाइल दोबारा खोलें। अगर डाउनलोड पूरा नहीं हुआ तो फिर से लें — अधूरी फ़ाइल नहीं खुलती।</string>
    <string name="faq_stuck_q">मेरा डाउनलोड नहीं चल रहा।</string>
    <string name="faq_stuck_a">दस में नौ बार प्रोवाइडर उस सर्वर को रोकता है। VPN चालू करके फ़ाइल फिर लें — लगभग हमेशा हल हो जाता है।</string>
    <string name="faq_hidden_q">इंस्टॉल है पर गेम में नहीं दिखता।</string>
    <string name="faq_hidden_a">अपनी दुनिया की सेटिंग खोलें और पैक वहीं चालू करें। कुछ मॉड के लिए उसी स्क्रीन पर प्रयोग भी चालू करने होते हैं।</string>
    <string name="faq_lag_q">गेम धीमा हो गया।</string>
    <string name="faq_lag_a">भारी सामग्री फ़ोन से बहुत माँगती है। रेंडर दूरी घटाएँ या दुनिया से बाकी पैक हटाकर सिर्फ़ ज़रूरी रखें।</string>
    <string name="faq_ads_q">विज्ञापन क्यों आते हैं?</string>
    <string name="faq_ads_a">विज्ञापन ऐप का खर्च उठाते हैं, इसलिए कैटलॉग सबके लिए मुफ़्त रहता है।</string>
    <string name="faq_free_q">क्या सब मुफ़्त है?</string>
    <string name="faq_free_a">हाँ। शेल्फ़ की हर चीज़ बिना पैसे लिए ली और इस्तेमाल की जा सकती है।</string>
    <string name="faq_fresh_q">नया कितनी बार आता है?</string>
    <string name="faq_fresh_a">नया नियमित रूप से शेल्फ़ पर आता है — कभी-कभी «ताज़ा» क्रम देखें।</string>
    <string name="faq_safe_q">क्या यह मेरी दुनिया बिगाड़ देगा?</string>
    <string name="faq_safe_a">ये गेम के अपने फ़ॉर्मैट हैं, कुछ अजीब इंस्टॉल नहीं होता। फिर भी ज़रूरी दुनिया की कॉपी बनाकर ही कुछ जोड़ें।</string>
