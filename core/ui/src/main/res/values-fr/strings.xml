    <!-- How to install -->
    <string name="walkthrough_title">Le mettre dans le jeu</string>
    <string name="walkthrough_s1_title">Choisis quelque chose</string>
    <string name="walkthrough_s1_text">Ouvre une fiche de l\'étagère et appuie sur « Prendre les fichiers ».</string>
    <string name="walkthrough_s2_title">Prends le fichier</string>
    <string name="walkthrough_s2_text">Appuie sur Prendre et attends que le fichier soit sur le téléphone.</string>
    <string name="walkthrough_s3_title">Transmets-le</string>
    <string name="walkthrough_s3_text">Une fois enregistré, appuie sur Donner à Minecraft — le système demande quelle appli prend le fichier.</string>
    <string name="walkthrough_s4_title">Indique Minecraft</string>
    <string name="walkthrough_s4_text">Choisis Minecraft dans la liste. Le jeu s\'ouvre tout seul et aspire le contenu.</string>
    <string name="walkthrough_s5_title">Laisse-le finir</string>
    <string name="walkthrough_s5_text">Minecraft affiche une barre pendant l\'import. Ne quitte pas le jeu avant la fin.</string>
    <string name="walkthrough_s6_title">Active-le dans ton monde</string>
    <string name="walkthrough_s6_text">Dans les réglages du monde, ajoute le pack dans ressources ou comportements.</string>
    <string name="walkthrough_s7_title">Va jouer</string>
    <string name="walkthrough_s7_text">Lance le monde et regarde ce qui a changé. Copie d\'abord les mondes auxquels tu tiens.</string>

