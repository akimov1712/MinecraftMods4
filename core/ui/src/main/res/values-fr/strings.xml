    <!-- How to install -->
    <string name="walkthrough_title">Comment installer</string>
    <string name="walkthrough_s1_title">Choisis un contenu</string>
    <string name="walkthrough_s1_text">Ouvre n\'importe quel contenu du catalogue et touche « Obtenir les fichiers ».</string>
    <string name="walkthrough_s2_title">Télécharge le fichier</string>
    <string name="walkthrough_s2_text">Touche « Télécharger » et attends la fin de l\'enregistrement du fichier.</string>
    <string name="walkthrough_s3_title">Touche « Installer »</string>
    <string name="walkthrough_s3_text">Une fois enregistré, touche « Installer » — le système demande quelle app doit ouvrir le fichier.</string>
    <string name="walkthrough_s4_title">Choisis Minecraft</string>
    <string name="walkthrough_s4_text">Sélectionne Minecraft dans la liste. Le jeu s\'ouvre et importe le contenu.</string>
    <string name="walkthrough_s5_title">Attends l\'import</string>
    <string name="walkthrough_s5_text">Minecraft affiche une barre de progression d\'import. Laisse-la se terminer.</string>
    <string name="walkthrough_s6_title">Active-le dans ton monde</string>
    <string name="walkthrough_s6_text">Dans les paramètres du monde, ajoute le pack dans les packs de ressources ou de comportement.</string>
    <string name="walkthrough_s7_title">Amuse-toi !</string>
    <string name="walkthrough_s7_text">Lance le monde et profite de ton nouveau contenu. Sauvegarde d\'abord les mondes importants.</string>

