    <!-- How to install -->
    <string name="walkthrough_title">Como levar ao jogo</string>
    <string name="walkthrough_s1_title">Escolha algo</string>
    <string name="walkthrough_s1_text">Abra qualquer card da prateleira e toque em «Pegar arquivos».</string>
    <string name="walkthrough_s2_title">Pegue o arquivo</string>
    <string name="walkthrough_s2_text">Toque em Pegar e espere o arquivo chegar ao telefone.</string>
    <string name="walkthrough_s3_title">Entregue</string>
    <string name="walkthrough_s3_text">Quando salvar, toque em Entregar ao Minecraft — o sistema pergunta qual app abre o arquivo.</string>
    <string name="walkthrough_s4_title">Aponte o Minecraft</string>
    <string name="walkthrough_s4_text">Escolha Minecraft nessa lista. O jogo abre sozinho e começa a puxar o conteúdo.</string>
    <string name="walkthrough_s5_title">Deixe terminar</string>
    <string name="walkthrough_s5_text">O Minecraft mostra uma barra enquanto importa. Não saia do jogo até terminar.</string>
    <string name="walkthrough_s6_title">Ative no seu mundo</string>
    <string name="walkthrough_s6_text">Nas configurações do mundo, adicione o pacote em recursos ou comportamentos.</string>
    <string name="walkthrough_s7_title">Vá jogar</string>
    <string name="walkthrough_s7_text">Inicie o mundo e veja o que mudou. Copie antes os mundos que você preza.</string>

