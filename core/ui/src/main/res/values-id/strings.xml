    <!-- How to install -->
    <string name="walkthrough_title">Cara memasukkan ke game</string>
    <string name="walkthrough_s1_title">Pilih sesuatu</string>
    <string name="walkthrough_s1_text">Buka kartu mana pun di rak lalu tekan «Ambil file».</string>
    <string name="walkthrough_s2_title">Ambil filenya</string>
    <string name="walkthrough_s2_text">Tekan Ambil dan tunggu sampai file ada di ponsel.</string>
    <string name="walkthrough_s3_title">Serahkan</string>
    <string name="walkthrough_s3_text">Setelah tersimpan, tekan Serahkan ke Minecraft — sistem akan menanyakan aplikasi mana yang membuka file.</string>
    <string name="walkthrough_s4_title">Tunjuk Minecraft</string>
    <string name="walkthrough_s4_text">Pilih Minecraft dari daftar itu. Game terbuka sendiri dan mulai menarik kontennya.</string>
    <string name="walkthrough_s5_title">Biarkan selesai</string>
    <string name="walkthrough_s5_text">Minecraft menampilkan bilah saat mengimpor. Jangan keluar dari game sampai selesai.</string>
    <string name="walkthrough_s6_title">Nyalakan di duniamu</string>
    <string name="walkthrough_s6_text">Di pengaturan dunia, tambahkan paket di resource atau behaviour pack.</string>
    <string name="walkthrough_s7_title">Ayo main</string>
