    <!-- FAQ -->
    <string name="compendium_title">Asisten</string>
    <string name="faq_what_q">Aplikasi ini untuk apa?</string>
    <string name="faq_what_a">Untuk menelusuri dan memasang karya gratis — addon, peta, tekstur, dan skin — untuk Minecraft.</string>
    <string name="faq_internet_q">Perlu koneksi internet?</string>
    <string name="faq_internet_a">Ya, untuk menelusuri dan mengunduh. Setelah file tersimpan, pemasangan bisa offline.</string>
    <string name="faq_how_q">Bagaimana cara memasang karya?</string>
    <string name="faq_how_a">Buka mod, tekan Ambil file, lalu tekan Unduh. Setelah tersimpan, tekan Buka di Minecraft — game akan terbuka dan menambahkannya sendiri.</string>
    <string name="faq_fail_q">Pemasangan gagal. Lalu bagaimana?</string>
    <string name="faq_fail_a">Pastikan Minecraft terpasang dan terbaru, lalu buka lagi filenya. Kalau unduhan tidak pernah selesai, nyalakan VPN dan ambil ulang.</string>
    <string name="faq_stuck_q">Unduhan saya macet.</string>
    <string name="faq_stuck_a">Biasanya penyedia internetmu memblokir server. Nyalakan VPN lalu unduh lagi — hampir selalu berhasil. VPN gratis apa pun bisa, dan boleh dimatikan setelahnya.</string>
    <string name="faq_hidden_q">Sudah dipasang tapi tidak ada di game.</string>
    <string name="faq_hidden_a">Buka pengaturan dunia dan aktifkan paketnya di sana. Sebagian mod juga perlu opsi eksperimen dinyalakan.</string>
    <string name="faq_lag_q">Game jadi patah-patah setelah dipasang.</string>
    <string name="faq_lag_a">Mod besar berat untuk ponsel. Turunkan jarak pandang atau lepas paket lain dari dunia itu.</string>
    <string name="faq_ads_q">Kenapa ada iklan?</string>
    <string name="faq_ads_a">Iklan membuat aplikasi dan semua karya tetap gratis.</string>
    <string name="faq_free_q">Semuanya gratis?</string>
    <string name="faq_free_a">Ya — semua karya di katalog gratis diunduh dan dipasang.</string>
    <string name="faq_fresh_q">Seberapa sering konten baru ditambahkan?</string>
    <string name="faq_fresh_a">Katalog diperbarui secara rutin dengan karya baru.</string>
    <string name="faq_safe_q">Apakah filenya aman untuk dunia saya?</string>
    <string name="faq_safe_a">Aman. Formatnya milik Minecraft sendiri. Tetap saja, cadangkan dunia penting sebelum menambah mod besar.</string>
