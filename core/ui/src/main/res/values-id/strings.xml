    <!-- FAQ -->
    <string name="compendium_title">Pemandu</string>
    <string name="faq_what_q">Aplikasi ini untuk apa?</string>
    <string name="faq_what_a">Ini rak berisi konten gratis untuk Minecraft: add-on, dunia, paket sumber daya, dan skin. Pilih, ambil filenya, game yang membukanya.</string>
    <string name="faq_internet_q">Perlu internet?</string>
    <string name="faq_internet_a">Untuk melihat-lihat dan mengambil file, ya. Setelah file ada di ponsel, ia masuk ke game tanpa koneksi.</string>
    <string name="faq_how_q">Bagaimana memasang mod ke game?</string>
    <string name="faq_how_a">Buka mod, tekan Ambil file lalu Ambil. Setelah file ada di ponsel, tekan Serahkan ke Minecraft — game terbuka dan mengimpornya.</string>
    <string name="faq_fail_q">Gagal dipasang. Lalu apa?</string>
    <string name="faq_fail_a">Pastikan dulu Minecraft terpasang dan terbaru, lalu buka filenya lagi. Kalau unduhan tak pernah selesai, ambil sekali lagi — file setengah jadi tidak bisa dibuka.</string>
    <string name="faq_stuck_q">Unduhanku tidak bergerak.</string>
    <string name="faq_stuck_a">Sembilan dari sepuluh kasus, penyedia memblokir server file-nya. Nyalakan VPN lalu ambil lagi — hampir selalu beres.</string>
    <string name="faq_hidden_q">Sudah dipasang tapi tidak ada di game.</string>
    <string name="faq_hidden_a">Buka pengaturan duniamu dan aktifkan paketnya di sana. Sebagian mod juga perlu opsi eksperimen dinyalakan di layar yang sama.</string>
    <string name="faq_lag_q">Game jadi lambat.</string>
    <string name="faq_lag_a">Konten berat menuntut banyak dari ponsel. Turunkan jarak pandang, atau keluarkan paket lain dari dunia dan sisakan yang kamu mau.</string>
    <string name="faq_ads_q">Kenapa ada iklan?</string>
    <string name="faq_ads_a">Iklan yang membiayai aplikasi, sehingga katalognya tetap gratis untuk semua.</string>
    <string name="faq_free_q">Apakah semua gratis?</string>
    <string name="faq_free_a">Ya. Semua yang ada di rak bisa diambil dan dipakai tanpa bayar.</string>
    <string name="faq_fresh_q">Seberapa sering ada yang baru?</string>
    <string name="faq_fresh_a">Yang baru rutin masuk ke rak — sesekali lihat urutan Terbaru.</string>
    <string name="faq_safe_q">Bisakah ini merusak duniaku?</string>
    <string name="faq_safe_a">Formatnya milik game sendiri, jadi tidak ada yang aneh dipasang. Meski begitu, salin dulu dunia yang kamu sayangi sebelum menambahkan apa pun.</string>
