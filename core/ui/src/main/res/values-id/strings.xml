    <!-- How to install -->
    <string name="walkthrough_title">Cara memasang</string>
    <string name="walkthrough_s1_title">Pilih karya</string>
    <string name="walkthrough_s1_text">Buka karya mana pun dari katalog lalu tekan «Ambil file».</string>
    <string name="walkthrough_s2_title">Unduh filenya</string>
    <string name="walkthrough_s2_text">Tekan Unduh dan tunggu sampai file selesai tersimpan.</string>
    <string name="walkthrough_s3_title">Tekan Pasang</string>
    <string name="walkthrough_s3_text">Setelah tersimpan, tekan Pasang — sistem akan menanyakan aplikasi mana yang membuka file itu.</string>
    <string name="walkthrough_s4_title">Pilih Minecraft</string>
    <string name="walkthrough_s4_text">Pilih Minecraft dari daftar. Game terbuka dan mengimpor kontennya.</string>
    <string name="walkthrough_s5_title">Tunggu impornya</string>
    <string name="walkthrough_s5_text">Minecraft menampilkan bilah kemajuan impor. Biarkan sampai selesai.</string>
    <string name="walkthrough_s6_title">Aktifkan di duniamu</string>
    <string name="walkthrough_s6_text">Di pengaturan dunia, tambahkan paketnya pada Resource atau Behavior packs.</string>
    <string name="walkthrough_s7_title">Selamat bermain!</string>
    <string name="walkthrough_s7_text">Mulai dunianya dan nikmati karya barumu. Cadangkan dulu dunia yang penting.</string>

